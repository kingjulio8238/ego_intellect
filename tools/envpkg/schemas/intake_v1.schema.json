{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake/v1",
  "title": "Vendor clip delivery manifest (intake/v1)",
  "description": "intake.json at the root of one vendor delivery. Contract: docs/pipeline/INTAKE.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "delivery_id", "vendor", "created_at", "license", "clips"],
  "properties": {
    "schema": {"const": "intake/v1"},
    "delivery_id": {"$ref": "#/$defs/id"},
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms", "commercial_use", "derivatives_allowed", "consent_obtained", "pii_reviewed"],
      "properties": {
        "terms": {"type": "string", "minLength": 1},
        "commercial_use": {"const": true},
        "derivatives_allowed": {"const": true},
        "consent_obtained": {"const": true},
        "pii_reviewed": {"const": true}
      }
    },
    "clips": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clip"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relpath": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relpath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "intrinsics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "width", "height", "fx", "fy", "cx", "cy", "distortion"],
      "properties": {
        "model": {"enum": ["pinhole", "opencv", "opencv_fisheye"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fx": {"type": "number", "exclusiveMinimum": 0},
        "fy": {"type": "number", "exclusiveMinimum": 0},
        "cx": {"type": "number"},
        "cy": {"type": "number"},
        "distortion": {"type": "array", "items": {"type": "number"}, "maxItems": 8}
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clip_id", "video", "task", "capture", "content"],
      "properties": {
        "clip_id": {"$ref": "#/$defs/id"},
        "video": {"$ref": "#/$defs/file"},
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object_prompt", "instruction"],
          "properties": {
            "object_prompt": {"type": "string", "minLength": 3, "maxLength": 80},
            "instruction": {"type": "string", "minLength": 3, "maxLength": 200},
            "category": {"enum": ["pick_place", "lift_hold", "push", "open_close", "pour", "handover", "other"]}
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["device", "mount"],
          "properties": {
            "device": {"type": "string", "minLength": 1},
            "mount": {"enum": ["head", "glasses", "chest", "handheld", "other"]},
            "captured_at": {"type": "string", "format": "date-time"},
            "intrinsics": {"$ref": "#/$defs/intrinsics"},
            "imu": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "format", "time_offset_s"],
              "properties": {
                "file": {"$ref": "#/$defs/file"},
                "format": {"const": "imu_csv/1"},
                "time_offset_s": {"type": "number", "description": "IMU time of the first video frame."}
              }
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hands_visible", "single_rigid_object", "faces_visible"],
          "properties": {
            "hands_visible": {"enum": ["both", "left", "right"]},
            "single_rigid_object": {"const": true},
            "faces_visible": {"const": false}
          }
        }
      }
    }
  }
}
